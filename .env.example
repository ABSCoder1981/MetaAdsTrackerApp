# Copy to .env.local and fill in with your own Supabase project's values.
# Never commit .env.local — it's gitignored.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only, never exposed to the browser — used by the Meta sync job (Sprint 2).
SUPABASE_SERVICE_ROLE_KEY=

# Secures the Vercel Cron endpoint (app/api/cron/sync) — Vercel sends this as
# `Authorization: Bearer $CRON_SECRET` automatically once set as a project
# env var. Generate any random string; only needed for the scheduled sync,
# not for manual "Sync now" testing via the UI.
CRON_SECRET=

# Note: Meta System User tokens are NOT stored as env vars — they're entered
# once via the "Connect Ad Account" form in the app UI (Business Manager +
# Ad Account ID + token) and stored encrypted in Supabase Vault, since a
# multi-tenant workspace can have a different Business Manager/token per
# workspace. See docs/ARCHITECTURE.md §4.
