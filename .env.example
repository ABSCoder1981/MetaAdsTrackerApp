# Copy to .env.local and fill in with your own Supabase project's values.
# Never commit .env.local — it's gitignored.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only, never exposed to the browser — used by the Meta sync job (Sprint 2).
SUPABASE_SERVICE_ROLE_KEY=

# Meta Marketing API (System User token, Sprint 2 — see docs/ARCHITECTURE.md §4).
META_APP_ID=
META_APP_SECRET=
META_SYSTEM_USER_TOKEN=
